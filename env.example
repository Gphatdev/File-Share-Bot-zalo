# ==============================================================================
#  NKNP V3 — .env.example
#  Sao chép file này thành ".env" rồi chỉnh lại giá trị cho phù hợp.
#  (Cấu hình bổ sung mang phong cách NKNP — admin/support/prefix... nằm ở
#  config.yml, không cần khai báo lại ở đây.)
# ==============================================================================

# Tên bot hiển thị trên banner + dashboard. Để trống sẽ lấy name_bot trong config.yml.
BOT_NAME=HNNP STUDIO

# Ký tự lệnh (prefix). Để trống sẽ lấy "prefix" trong config.yml.
BOT_PREFIX=!

# UID Zalo của chủ bot (owner, role cao nhất). Có thể để trống lần đầu chạy —
# log sẽ in ra UID sau khi đăng nhập, copy vào đây rồi khởi động lại.
OWNER_ZALO_ID=

# Đường dẫn lưu session đăng nhập (cookie) — để lần sau không cần quét QR lại.
SESSION_PATH=./App/Session.json
# Mã QR đăng nhập mới được hiển thị trực tiếp trong terminal, không tạo file.

# Tùy chọn: khóa mã hóa session tối thiểu 32 ký tự.
# Nếu để trống, bot tự tạo App/Session.key; hãy giữ file này cùng Session.json.
SESSION_SECRET=

# Đường dẫn database chính (EMPHAT — sql.js). DB "di sản" (Users/Threads của
# các lệnh port từ NKNP) nằm riêng tại Data/legacy/nknp-legacy.db, tự tạo.
DB_PATH=./Data/nknp-v3.db

# Cổng chạy dashboard web (server.js)
PORT=3000

# Mức log: debug | info | warn | error
LOG_LEVEL=info

# Danh sách domain được phép (không bị lọc bởi lệnh chống spam link), cách nhau bằng dấu phẩy
ANTI_LINK_ALLOWLIST=zalo.me,youtube.com,facebook.com

# Khóa API Groq cho tính năng AI (để trống nếu không dùng).
GROQ_API_KEY=

# ----- Lệnh .scl (tìm nhạc YouTube) -----
# KHÔNG cần điền gì cũng chạy được: mặc định dùng API công khai miễn phí (Piped/Invidious) — kém ổn định hơn key riêng.
# Muốn ổn định hơn: điền MỘT nguồn bên dưới. KHÔNG đưa key thật vào source/ZIP.
# SCL_PUBLIC=0 để tắt API công khai; SCL_PUBLIC_INSTANCES="piped:https://a.example,inv:https://b.example" để tự chọn instance.
SCL_PUBLIC=1
SCL_PUBLIC_INSTANCES=
# 1) YouTube Data API v3 (khuyên dùng): tạo key tại Google Cloud Console, bật "YouTube Data API v3".
YOUTUBE_API_KEY=
# 2) Dự phòng: Invidious tự triển khai (ví dụ https://invidious.cua-ban.example). Để trống = tắt.
SCL_INVIDIOUS_URL=
# 3) Dự phòng: yt-dlp cài sẵn trên máy chạy bot. SCL_YTDLP=1 (dùng lệnh "yt-dlp" trong PATH) hoặc SCL_YTDLP_PATH=đường dẫn đầy đủ.
SCL_YTDLP=
SCL_YTDLP_PATH=
# Thứ tự ưu tiên nguồn (mặc định: youtube,invidious,ytdlp)
SCL_PROVIDERS=youtube,invidious,ytdlp,public
# Ghi âm khi chọn bài (cần yt-dlp; tắt bằng 0). SCL_AUDIO_MAX_SEC = độ dài tối đa (giây) của bài được gửi ghi âm.
SCL_AUDIO=1
SCL_AUDIO_MAX_SEC=1200
# Nếu YouTube chặn (429 / 'Sign in to confirm you're not a bot'): đổi mạng, hoặc cho yt-dlp dùng cookie (rủi ro cho tài khoản, nên dùng tài khoản phụ). Để trống = không dùng.
SCL_YTDLP_COOKIES_FROM_BROWSER=
SCL_YTDLP_COOKIES=

# SCL - thư viện youtubei.js (nằm trong package.json, cài bằng npm install; không cần yt-dlp ngoài)
# SCL_YTLIB=0                              # tắt nguồn này
# SCL_YT_CLIENTS=TV_EMBEDDED,ANDROID_VR,TV,IOS   # thứ tự client InnerTube thử lần lượt
